# Copy to .env.local for local development. On Vercel, add these in
# Project Settings -> Environment Variables. NEVER commit real values.

# Anthropic API key (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather (looks like 123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# Your personal chat id with the bot (a number, see SETUP.md step 2)
TELEGRAM_CHAT_ID=

# Any long random string. Protects the cron endpoints. Generate one with:
#   openssl rand -hex 32
CRON_SECRET=

# The FULL contents of your Firebase service account JSON file, pasted as
# one value (Vercel handles multi-line values fine). Base64 also accepted.
FIREBASE_SERVICE_ACCOUNT=

# Read-only key for GET /api/snapshot — the TradeGenie bridge. Another long
# random string, and deliberately NOT the same one as CRON_SECRET: this key
# lives in the other app, and it must not be able to trigger digests or
# ingests. The SAME value goes in both Vercel projects (here, and TradeGenie
# as SIGNALDESK_SNAPSHOT_TOKEN). Generate with:
#   openssl rand -hex 32
# Leave it unset and the bridge is simply off — both apps work as before.
SNAPSHOT_TOKEN=
