# Copy to .env.local for local development. On Vercel, add these in
# Project Settings -> Environment Variables. NEVER commit real values.

# Anthropic API key (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather (looks like 123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# Your personal chat id with the bot (a number, see SETUP.md step 2)
TELEGRAM_CHAT_ID=

# Any long random string. Protects the cron endpoints. Generate one with:
#   openssl rand -hex 32
CRON_SECRET=

# The FULL contents of your Firebase service account JSON file, pasted as
# one value (Vercel handles multi-line values fine). Base64 also accepted.
FIREBASE_SERVICE_ACCOUNT=
